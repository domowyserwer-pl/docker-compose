# Dokumentację wszystkich wspieranych zmiennych znajdziesz na: https://docs.immich.app/install/environment-variables

# Lokalizacja, w której będą przechowywane Twoje przesłane zdjęcia i filmy
# Domyślnie: folder "library" w tym samym katalogu co plik compose
UPLOAD_LOCATION=./library

# Lokalizacja plików bazy danych PostgreSQL.
# WAŻNE: Nie używaj dysków sieciowych (SMB/NFS) dla bazy, ponieważ grozi to uszkodzeniem danych.
DB_DATA_LOCATION=./postgres

# Strefa czasowa. Usuń "#" i zmień na odpowiednią, np. Europe/Warsaw
# Pozwala to na poprawne sortowanie zdjęć i logów według polskiego czasu
# TZ=Europe/Warsaw

# Wersja Immich, której chcesz używać.
# Możesz wpisać konkretną wersję (np. v1.114.0) lub zostawić "release" dla najnowszej stabilnej.
IMMICH_VERSION=release

# Hasło do bazy danych PostgreSQL. KONIECZNIE zmień je na własne, losowe hasło.
# Używaj tylko liter (A-Z, a-z) i cyfr (0-9) – unikaj znaków specjalnych i spacji.
DB_PASSWORD=TwojeSilneHaslo123

# Poniższe wartości zazwyczaj nie wymagają zmiany przez użytkownika
###################################################################################

# Nazwa użytkownika bazy danych (domyślnie: postgres)
DB_USERNAME=postgres

# Nazwa bazy danych wewnątrz PostgreSQL (domyślnie: immich)
DB_DATABASE_NAME=immich